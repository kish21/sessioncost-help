---
// The SessionCost loop: chat, report, find the heavy turn, apply a fix, chat again.
const steps = [
	{ x: 20, title: 'Chat as usual', sub: 'any agent' },
	{ x: 200, title: '/sessioncost', sub: 'the report opens' },
	{ x: 380, title: 'Find the heavy turn', sub: 'the path, the turn panel' },
	{ x: 560, title: 'Apply a fix', sub: 'paste the rule' },
];
---
<figure class="diagram" aria-label="Chat as usual, type /sessioncost, find the heavy turn, apply a fix, then the next chat sends less">
	<svg viewBox="0 0 740 230" role="img">
		<text class="kicker" x="370" y="20" text-anchor="middle">One loop, every chat</text>
		{steps.map((s, i) => (
			<g>
				<rect class="box" x={s.x} y="60" width="160" height="70" rx="4" />
				<text class="label" x={s.x + 80} y="92" text-anchor="middle">{s.title}</text>
				<text class="small" x={s.x + 80} y="113" text-anchor="middle">{s.sub}</text>
				{i < steps.length - 1 && <path class="line" d={`M${s.x + 162} 95 H${s.x + 196}`} marker-end="url(#arrow)" />}
			</g>
		))}
		<path class="line accent" stroke-dasharray="5 5" d="M640 132 C640 190, 100 190, 100 134" marker-end="url(#arrow)" />
		<text class="small" x="370" y="196" text-anchor="middle">the next chat sends less</text>
		<text class="foot" x="370" y="224" text-anchor="middle">measured from your own chat, on your computer</text>
		<defs>
			<marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
			</marker>
		</defs>
	</svg>
</figure>
